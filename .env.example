# Required: get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional bot settings.
BOT_NAME=Salasil Bot
DEBUG=false

# Optional: enables live event results from Ticketmaster.
# Use your Ticketmaster Developer Consumer Key.
# The bot still works without this by using local JSON fallback data.
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# Optional: two-letter country code such as IQ, JO, AE, GB, or US.
TICKETMASTER_COUNTRY_CODE=
