# Port the server listens on (HTTP + WebSocket on the same port)
PORT=8787
# Where active rooms/games are persisted (JSON snapshots, replayed on restart)
DATA_DIR=./data/rooms
# file (default) or memory
STORE=file
# Set to 1 ONLY for local development: enables debug rooms (scenario loader, state inspector, act-as-any-seat)
ENABLE_DEBUG=0
# Delay before server bots act (ms)
BOT_DELAY_MS=900
