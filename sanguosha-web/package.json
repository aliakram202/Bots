{
  "name": "sanguosha-web",
  "version": "0.1.0",
  "private": true,
  "description": "Three Kingdoms Table — a San Guo Sha compatible private game simulator",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src e2e scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "docs:gen": "tsx scripts/gen-docs.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
